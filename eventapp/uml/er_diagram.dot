digraph ERDiagram {
    rankdir=LR;
    fontname="Arial";
    node [shape=none, fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=9, arrowhead=crow, arrowtail=none];

    users [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#2f5d8a"><font color="white"><b>users</b></font></td></tr>
        <tr><td align="left">PK id</td></tr>
        <tr><td align="left">full_name</td></tr>
        <tr><td align="left">email (UNIQUE)</td></tr>
        <tr><td align="left">phone</td></tr>
        <tr><td align="left">password_hash</td></tr>
        <tr><td align="left">role</td></tr>
        <tr><td align="left">created_at</td></tr>
        </table>>];

    events [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#2f5d8a"><font color="white"><b>events</b></font></td></tr>
        <tr><td align="left">PK id</td></tr>
        <tr><td align="left">FK organizer_id</td></tr>
        <tr><td align="left">title</td></tr>
        <tr><td align="left">description</td></tr>
        <tr><td align="left">category</td></tr>
        <tr><td align="left">location</td></tr>
        <tr><td align="left">start_datetime</td></tr>
        <tr><td align="left">end_datetime</td></tr>
        <tr><td align="left">capacity</td></tr>
        <tr><td align="left">price</td></tr>
        <tr><td align="left">status</td></tr>
        </table>>];

    registrations [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#2f5d8a"><font color="white"><b>registrations</b></font></td></tr>
        <tr><td align="left">PK id</td></tr>
        <tr><td align="left">FK event_id</td></tr>
        <tr><td align="left">FK participant_id</td></tr>
        <tr><td align="left">status</td></tr>
        <tr><td align="left">registered_at</td></tr>
        <tr><td align="left">UNIQUE(event_id, participant_id)</td></tr>
        </table>>];

    payments [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#2f5d8a"><font color="white"><b>payments</b></font></td></tr>
        <tr><td align="left">PK id</td></tr>
        <tr><td align="left">FK registration_id</td></tr>
        <tr><td align="left">amount</td></tr>
        <tr><td align="left">method</td></tr>
        <tr><td align="left">status</td></tr>
        <tr><td align="left">transaction_ref</td></tr>
        <tr><td align="left">created_at</td></tr>
        <tr><td align="left">paid_at</td></tr>
        </table>>];

    notifications [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#2f5d8a"><font color="white"><b>notifications</b></font></td></tr>
        <tr><td align="left">PK id</td></tr>
        <tr><td align="left">FK user_id</td></tr>
        <tr><td align="left">FK event_id (nullable)</td></tr>
        <tr><td align="left">type</td></tr>
        <tr><td align="left">subject</td></tr>
        <tr><td align="left">body</td></tr>
        <tr><td align="left">status</td></tr>
        <tr><td align="left">created_at / sent_at</td></tr>
        </table>>];

    users -> events [taillabel="1", headlabel="0..*", label="организует"];
    events -> registrations [taillabel="1", headlabel="0..*", label="принимает"];
    users -> registrations [taillabel="1", headlabel="0..*", label="оформляет"];
    registrations -> payments [taillabel="1", headlabel="0..1", label="оплачивается"];
    users -> notifications [taillabel="1", headlabel="0..*", label="получает"];
    events -> notifications [taillabel="1", headlabel="0..*", label="порождает", style=dashed];
}
